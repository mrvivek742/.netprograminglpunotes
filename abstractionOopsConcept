using System;
class code
{
    abstract class calculator
    {
        public abstract int Add(int a, int b);//anstract method 
        //abstract doesnot have body and it will only show what to do
    }
    class result : calculator
    {
        public override int Add(int a,int b)
        {
            return a + b;
        }
    }
    public static void Main()
    {
        result obj = new result();
        int k=obj .Add(10,29);
        Console.WriteLine(k);
    }
}
